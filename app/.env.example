# Application environment — copy this file to app/.env for local (non-Docker)
# development and testing. When running via Docker Compose, the app container
# receives DATABASE_URL automatically (built from the POSTGRES_* values in the
# repository root .env); app/.env is never used inside the container.

# development | test | production
NODE_ENV=development

# Port for the local Node.js server
PORT=3200

# PostgreSQL connection for local development.
# 5434 is the default host port this project publishes for the compose
# postgres service (override via POSTGRES_PORT in the root .env).
DATABASE_URL=postgresql://housewife:change_me_strong_local_password@localhost:5434/housewife_diary

# Session signing secret (required when NODE_ENV=production; the repository
# root .env must provide one for Docker Compose, which fails fast without it).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# bcrypt cost (default 12, minimum 10 in production; tests override to 4).
# BCRYPT_COST=12
